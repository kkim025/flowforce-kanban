generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  password              String
  name                  String?
  role                  Role                   @default(MEMBER)
  status                UserStatus             @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  boards                Board[]
  timeEntries           TimeEntry[]
  tasks                 Task[]
  comments              Comment[]
  activities            Activity[]
  receivedNotifications Notification[]         @relation("NotificationRecipient")
  authoredNotifications Notification[]         @relation("NotificationActor")
  notificationPrefs     UserNotificationPref[]
  // Board sharing relations
  memberships           BoardMember[]          @relation("BoardMemberUser")
  authoredBoardShares   BoardShare[]           @relation("BoardShareInviter")
  // Wiki relations (FLO-Wiki)
  createdWikiPages      WikiPage[]             @relation("WikiPageCreator")
  updatedWikiPages      WikiPage[]             @relation("WikiPageUpdater")
  archivedWikiPages     WikiPage[]             @relation("WikiPageArchiver")
  wikiPageVersions      WikiPageVersion[]      @relation("WikiPageVersionEditor")
}

model Invitation {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String   @unique
  role      Role     @default(MEMBER)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  MEMBER
}

enum UserStatus {
  ACTIVE
  PENDING
  INACTIVE
}

model Board {
  id            String         @id @default(uuid())
  title         String
  ownerId       String
  status        BoardStatus    @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  owner         User           @relation(fields: [ownerId], references: [id])
  columns       Column[]
  sprints       Sprint[]
  notifications Notification[]
  // Board sharing relations
  members       BoardMember[]
  shares        BoardShare[]
  // Wiki relation (FLO-Wiki)
  wikiSpace     WikiSpace?
  // Tag library (issue #32) — every tag belongs to exactly one board.
  tags          Tag[]
}

model Column {
  id        String   @id @default(uuid())
  title     String
  order     Int
  wipLimit  Int?
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Sprint {
  id        String       @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    SprintStatus @default(PLANNING)
  boardId   String
  color     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  board     Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Task {
  id               String      @id @default(uuid())
  content          String
  description      String?
  priority         Priority    @default(MEDIUM)
  order            Int
  columnId         String
  archived         Boolean     @default(false)
  assigneeId       String?
  sprintId         String?
  estimatedMinutes Int?
  dueDate          DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  checklists       Checklist[]
  subtasks         Subtask[]   @relation("TaskSubtasks")
  comments         Comment[]
  activities       Activity[]
  timeEntries      TimeEntry[]
  taskTags         TaskTag[]
  column           Column      @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee         User?       @relation(fields: [assigneeId], references: [id])
  sprint           Sprint?     @relation(fields: [sprintId], references: [id])

  // Backs the DueDateScanner query: `dueDate IN window AND assigneeId IS NOT NULL AND archived = false`.
  // Without this, the scanner degrades to a sequential scan on the tasks table as it grows.
  @@index([dueDate, assigneeId, archived])
}

model Comment {
  id               String   @id @default(uuid())
  content          String
  taskId           String
  userId           String
  mentionedUserIds String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id])
}

model Activity {
  id        String   @id @default(uuid())
  type      String
  details   Json?
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Checklist {
  id        String    @id @default(uuid())
  title     String
  taskId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items     Subtask[] @relation("ChecklistSubtasks")
}

model Subtask {
  id          String     @id @default(uuid())
  content     String
  completed   Boolean    @default(false)
  order       Int        @default(0)
  priority    Priority?
  checklistId String?
  taskId      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  checklist   Checklist? @relation("ChecklistSubtasks", fields: [checklistId], references: [id], onDelete: Cascade)
  task        Task?      @relation("TaskSubtasks", fields: [taskId], references: [id], onDelete: Cascade)
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum BoardStatus {
  ACTIVE
  ARCHIVED
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

model TimeEntry {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  minutes   Int
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  actorId     String?
  type        NotificationType
  title       String
  body        String?
  refType     String
  refId       String
  boardId     String?
  milestone   String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  board       Board?           @relation(fields: [boardId], references: [id], onDelete: SetNull)

  @@unique([recipientId, type, refId, milestone])
  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

model UserNotificationPref {
  id           String           @id @default(uuid())
  userId       String
  type         NotificationType
  inAppEnabled Boolean          @default(true)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

enum NotificationType {
  ASSIGNMENT
  MENTION
  SPRINT_STATUS
  DUE_DATE
}

// Board sharing — see FLO-17 / FLO-18.
// BoardShare is a row representing a pending or resolved invitation to view/edit
// a board. BoardMember is the resolved "this user has access" row, created when
// a BoardShare is accepted (or for the owner / direct grants).
model BoardShare {
  id              String           @id @default(uuid())
  publicId        String           @unique @default(uuid())
  boardId         String
  email           String
  permissionLevel PermissionLevel  @default(VIEW)
  status          BoardShareStatus @default(PENDING)
  invitedById     String
  inviteToken     String           @unique
  tokenExpiresAt  DateTime
  acceptedAt      DateTime?
  declinedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  board           Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation("BoardShareInviter", fields: [invitedById], references: [id])

  @@unique([boardId, email])
  // Lookups for the "pending invites for this user" query and the board-level listing.
  @@index([email, status])
  @@index([boardId, status])
}

model BoardMember {
  id        String          @id @default(uuid())
  publicId  String          @unique @default(uuid())
  boardId   String
  userId    String
  role      BoardMemberRole @default(VIEWER)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  board     Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User            @relation("BoardMemberUser", fields: [userId], references: [id])

  @@unique([boardId, userId])
  @@index([userId])
}

enum PermissionLevel {
  VIEW
  EDIT
}

enum BoardShareStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum BoardMemberRole {
  VIEWER
  EDITOR
  ADMIN
}

// =====================================================================
// Tags (issue #32) — see GitHub issue #32.
//
// Tag is a per-board library entry (name + color). TaskTag is the
// many-to-many join between Task and Tag, replacing the legacy
// `Task.tags String[]` field. Tags belong to a board so that two
// boards can independently define "bug" or "frontend" without
// collisions. Unique `(boardId, name)` keeps the library tidy.
// =====================================================================

model Tag {
  id        String   @id @default(uuid())
  boardId   String
  name      String
  color     String   @default("#94a3b8")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board    Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  taskTags TaskTag[]

  @@unique([boardId, name])
  // Library listing per board is sorted alphabetically.
  @@index([boardId, name])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  // "All tasks with tag X" lookups.
  @@index([tagId])
}

// =====================================================================
// Wiki (FLO-Wiki) — see docs/wiki-proposal.md and GitHub issue #23.
//
// WikiSpace is 1:1 with Board (one wiki per board, MVP).
// WikiPage is an adjacency-list tree (parentId) of markdown docs.
// WikiPageVersion is append-only history; pruned to 50 per page on save.
// =====================================================================

model WikiSpace {
  id        String     @id @default(uuid())
  boardId   String     @unique
  board     Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  pages     WikiPage[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model WikiPage {
  id           String    @id @default(uuid())
  spaceId      String
  parentId     String?
  slug         String
  title        String
  content      String
  order        Int       @default(0)
  archived     Boolean   @default(false)
  archivedAt   DateTime?
  archivedById String?
  createdById  String
  updatedById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  space      WikiSpace         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parent     WikiPage?         @relation("WikiPageTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   WikiPage[]        @relation("WikiPageTree")
  versions   WikiPageVersion[]
  createdBy  User              @relation("WikiPageCreator", fields: [createdById], references: [id])
  updatedBy  User              @relation("WikiPageUpdater", fields: [updatedById], references: [id])
  archivedBy User?             @relation("WikiPageArchiver", fields: [archivedById], references: [id], onDelete: SetNull)

  @@unique([spaceId, parentId, slug])
  // Sidebar tree: list children of a parent, ordered.
  @@index([spaceId, parentId, order])
  // "Recent updates" feed in MVP.
  @@index([spaceId, archived, updatedAt])
  // Trash view.
  @@index([spaceId, archived, archivedAt])
}

model WikiPageVersion {
  id         String   @id @default(uuid())
  pageId     String
  revisionNo Int
  title      String
  content    String
  editorId   String
  createdAt  DateTime @default(now())
  page       WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  editor     User     @relation("WikiPageVersionEditor", fields: [editorId], references: [id])

  @@unique([pageId, revisionNo])
  // History dropdown queries.
  @@index([pageId, createdAt])
}
