# FlowForce API base URL, no trailing slash.
FLOWFORCE_API_URL=http://localhost:5000

# Port for the MCP HTTP server.
FLOWFORCE_PORT=3001

# Path the MCP server mounts on. Leading/trailing slashes are normalized.
FLOWFORCE_MCP_PATH=/mcp

# Credentials for the hello-world smoke test.
# Phase 1 only supports email/password login (will be replaced by
# API key + OAuth support in Phase 6 once issue #45 lands).
FLOWFORCE_EMAIL=user@example.com
FLOWFORCE_PASSWORD=password